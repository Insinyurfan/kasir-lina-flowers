datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  fullName     String     @default("")
  profilePhoto String?    @db.Text
  password     String
  role         String
  carts        UserCart[]
}

model Product {
  id                Int                @id @default(autoincrement())
  nama_produk       String
  harga             Int
  satuanHarga       String             @default("pcs")
  stok              Int
  barcode           String?            @unique
  gambar            String?
  gambarPosX        Int                @default(50)
  gambarPosY        Int                @default(50)
  isArchived        Boolean            @default(false)
  TransactionItems  TransactionItem[]
  cartItems         UserCartItem[]
  orderRequestItems OrderRequestItem[]
  variants          ProductVariant[]
  tarifPengrajin    TarifPengrajin[]
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // "S", "M", "L", "Merah", "Biru", etc
  priceModifier Int? // Absolute price for this variant (nullable, match DB)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
}

model Transaction {
  id                Int               @id @default(autoincrement())
  trxNumber         Int?              @unique
  tanggal           DateTime          @default(now())
  total_harga       Int
  metode_pembayaran String
  status            String            @default("Paid")
  nama_pembeli      String?
  customerId        Int? // tautan opsional ke master Customer; nama_pembeli tetap snapshot tampilan
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  nama_kasir        String?
  status_pengiriman String            @default("Diproses")
  nama_pengrajin    String?
  items             TransactionItem[]
  notifications     Notification[]
  orderRequest      OrderRequest?
  payments          Payment[]

  @@index([customerId])
}

// Pembayaran atas sebuah transaksi. Satu transaksi boleh menerima beberapa
// pembayaran (cicilan). Sisa tagihan = total_harga − Σ nominal pembayaran.
//
// Kolom `Transaction.status` TIDAK dihapus: ia menjadi cache yang HANYA ditulis
// server bersamaan dengan perubahan di tabel ini, supaya seluruh kode lama yang
// menyaring `status === "Paid"` (dashboard, laporan, ekspor) tetap benar.
model Payment {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tanggal       DateTime    @default(now()) // kapan uang benar-benar diterima
  nominal       Int
  metode        String // Tunai | Transfer Bank | QRIS
  catatan       String?
  pencatatId    Int?
  pencatatNama  String?
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([tanggal])
}

// Pengeluaran usaha. Kategori "Ambilan Pribadi" (prive) ikut mengurangi kas
// tetapi TIDAK mengurangi laba usaha — pemisahannya ada di lib/pengeluaran.ts.
model Expense {
  id           Int      @id @default(autoincrement())
  tanggal      DateTime @default(now())
  nominal      Int
  kategori     String
  catatan      String?
  metode       String   @default("Tunai")
  fotoUrl      String?  @db.Text
  pencatatId   Int?
  pencatatNama String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tanggal])
  @@index([kategori])
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  variantId     Int? // reference ke ProductVariant (optional, untuk info saja)
  variantName   String? // snapshot: "L", "Merah" (nullable karena produk bisa tanpa variant)
  label         String? // kode pelanggan per baris (mis. Aneka: AMN/SMT), TERPISAH dari variasi
  basePrice     Int         @default(0) // snapshot: harga base produk saat transaksi
  priceModifier Int? // snapshot: modifier dari variant saat transaksi (nullable jika tanpa variant)
  jumlah        Int
  subtotal      Int // (basePrice + priceModifier) × jumlah
  satuanHarga   String      @default("pcs")
  packed        Boolean     @default(false) // checklist packing: sudah masuk mobil?
  packedAt      DateTime? // waktu dicentang masuk mobil
  // Penugasan ke pengrajin. SENGAJA per baris, bukan per transaksi: dalam satu
  // nota, Bando Satin dan Bando Pompom bisa dikerjakan orang berbeda.
  // `packed` dan penugasan adalah dua tahap terpisah — barang boleh sudah
  // disetor pengrajin tapi belum masuk mobil, dan sebaliknya.
  penugasan     Penugasan[]
}

// Kelompok pengrajin (mis. Ketua Mama Budi → Mama Uri, Mama Ari).
// `ketuaId` merujuk Pengrajin, BUKAN nama teks bebas, karena ketua juga
// mengerjakan barang dan memegang saldo upah limpahan anggotanya.
model Kelompok {
  id        Int         @id @default(autoincrement())
  nama      String      @unique // dinormalisasi UPPERCASE
  ketuaId   Int?        @unique
  ketua     Pengrajin?  @relation("KetuaKelompok", fields: [ketuaId], references: [id], onDelete: SetNull)
  anggota   Pengrajin[] @relation("AnggotaKelompok")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Pengrajin {
  id         Int       @id @default(autoincrement())
  nama       String    @unique // dinormalisasi UPPERCASE
  kelompokId Int?
  kelompok   Kelompok? @relation("AnggotaKelompok", fields: [kelompokId], references: [id], onDelete: SetNull)
  ketuaDari  Kelompok? @relation("KetuaKelompok")

  // Tarif cadangan: dipakai bila produk yang disetor belum punya baris
  // TarifPengrajin. Tanpa ini, satu produk baru membuat setoran GAGAL dicatat
  // tepat di pagi tersibuk. Boleh null — kalau null dan tarif produk juga
  // kosong, setoran ditolak dengan pesan yang menyebut pengrajin & produknya.
  tarifCadangan Int?
  satuanTarif   String @default("gross")

  // "SENDIRI" = upah masuk saldo dirinya. "KETUA" = diteruskan ke ketua
  // kelompoknya, yang lalu membagi sendiri. Ketua kelompok WAJIB "SENDIRI"
  // supaya tidak ada rantai penerusan berputar.
  penerimaUpah String  @default("SENDIRI")
  aktif        Boolean @default(true)

  tarif         TarifPengrajin[]
  penugasan     Penugasan[]
  setoranKerja  Setoran[]        @relation("PekerjaSetoran")
  setoranTerima Setoran[]        @relation("PenerimaSetoran")
  penarikan     Penarikan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aktif])
  @@index([kelompokId])
}

// Tarif upah per pasangan pengrajin × produk. Bando Pompom yang lebih rumit
// dibayar lebih tinggi daripada Bando Satin, dan besarannya beda antar orang.
model TarifPengrajin {
  id          Int       @id @default(autoincrement())
  pengrajinId Int
  pengrajin   Pengrajin @relation(fields: [pengrajinId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  tarif       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([pengrajinId, productId])
  @@index([pengrajinId])
}

model Penugasan {
  id                Int             @id @default(autoincrement())
  transactionItemId Int
  transactionItem   TransactionItem @relation(fields: [transactionItemId], references: [id], onDelete: Cascade)
  pengrajinId       Int
  pengrajin         Pengrajin       @relation(fields: [pengrajinId], references: [id], onDelete: Restrict)

  // Satu baris pesanan boleh dibagi ke beberapa pengrajin, jadi jumlahnya
  // disimpan per penugasan. Total seluruh penugasan pada satu baris divalidasi
  // di server agar tidak melebihi `TransactionItem.jumlah`.
  jumlahDitugaskan Int
  tenggat          DateTime // tanggal janji selesai; bawaan 3 hari dari penugasan
  catatan          String?
  pembuatId        Int?
  pembuatNama      String?

  setoran Setoran[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionItemId])
  @@index([pengrajinId])
  @@index([tenggat])
}

// Setoran barang jadi. SATU kejadian ini menggerakkan dua hal: mengurangi sisa
// penugasan di papan tugas, dan menambah saldo upah penerima.
model Setoran {
  id          Int       @id @default(autoincrement())
  penugasanId Int
  penugasan   Penugasan @relation(fields: [penugasanId], references: [id], onDelete: Restrict)

  // Dua pihak dicatat terpisah: `pengrajinId` yang MENGERJAKAN (riwayat kerja
  // tetap menempel padanya), `penerimaId` yang SALDONYA bertambah.
  pengrajinId Int
  pengrajin   Pengrajin @relation("PekerjaSetoran", fields: [pengrajinId], references: [id], onDelete: Restrict)
  penerimaId  Int
  penerima    Pengrajin @relation("PenerimaSetoran", fields: [penerimaId], references: [id], onDelete: Restrict)

  tanggal DateTime @default(now())
  jumlah  Int

  // Snapshot tarif saat setoran dicatat — kenaikan tarif kelak TIDAK boleh
  // mengubah nilai setoran yang mungkin sudah dibayar.
  tarifSnapshot      Int
  pakaiTarifCadangan Boolean @default(false)
  nilai              Int // jumlah × tarifSnapshot

  catatan      String?
  pencatatId   Int?
  pencatatNama String?
  createdAt    DateTime @default(now())

  @@index([pengrajinId])
  @@index([penerimaId])
  @@index([tanggal])
}

// Pencairan upah. Biaya diakui di sini, BUKAN saat setoran — konsisten dengan
// basis kas pada change pengeluaran-piutang-laba. `expenseId` menautkannya ke
// Expense berkategori "Upah Pengrajin" agar masuk laporan Laba Rugi.
model Penarikan {
  id          Int       @id @default(autoincrement())
  pengrajinId Int // penerima saldo yang menarik
  pengrajin   Pengrajin @relation(fields: [pengrajinId], references: [id], onDelete: Restrict)
  tanggal     DateTime  @default(now())
  nominal     Int
  expenseId   Int?      @unique

  catatan      String?
  pencatatId   Int?
  pencatatNama String?
  createdAt    DateTime @default(now())

  @@index([pengrajinId])
  @@index([tanggal])
}

model StoreSetting {
  id          Int     @id @default(1)
  brand       String  @default("Lina Flowers")
  address     String
  footer      String
  logo        String? @db.Text
  receiptLogo String? @db.Text
  // Nomor WhatsApp tujuan pesanan katalog publik, format internasional tanpa
  // tanda plus (mis. 6281247000600). Kosong = tombol pesan disembunyikan,
  // sehingga katalog otomatis kembali jadi "lihat-lihat saja" bila belum diisi.
  whatsapp    String?
}

// Harga khusus per pelanggan (mis. Toko Aneka punya harga berbeda dari harga
// universal). Diingat otomatis saat kasir menyesuaikan harga, lalu dipakai
// kembali untuk pelanggan yang sama. variantId 0 = harga level produk (tanpa varian).
model CustomerPrice {
  id           Int       @id @default(autoincrement())
  customerName String // dinormalisasi UPPERCASE — snapshot/fallback selama transisi
  customerId   Int? // kunci utama harga khusus setelah migrasi (master Customer)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId    Int
  variantId    Int       @default(0)
  price        Int // harga dasar (per satuanHarga produk)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([customerName, productId, variantId])
  @@index([customerName])
  @@index([customerId])
}

// Master pelanggan (nama kanonik). Kode Aneka (AMN/SMT/ST) TIDAK di sini —
// itu tetap `label` per baris pada TransactionItem/UserCartItem.
model Customer {
  id           Int             @id @default(autoincrement())
  name         String          @unique // nama kanonik, dinormalisasi UPPERCASE
  phone        String?
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  prices       CustomerPrice[]
  transactions Transaction[]

  @@index([name])
}

// Daftar kode pelanggan (mis. Aneka: AMN/SMT/HARLIS) sebagai master untuk
// autocomplete, terpisah dari variasi produk. Tumbuh otomatis saat kode dipakai.
model CustomerCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique // dinormalisasi UPPERCASE
  createdAt DateTime @default(now())
}

model Notification {
  id               Int          @id @default(autoincrement())
  transactionId    Int?
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  targetRole       String
  senderRole       String
  senderName       String?
  statusPengiriman String
  message          String
  isRead           Boolean      @default(false)
  hidden           Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@unique([transactionId, targetRole, senderRole, statusPengiriman])
  @@index([targetRole, isRead, createdAt])
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  action      String
  entity      String
  entityId    String?
  title       String
  description String
  actorId     Int?
  actorName   String?
  actorRole   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entity, action])
  @@index([actorRole, createdAt])
}

model UserCart {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope         String         @default("produk")
  customerName  String?
  paymentMethod String?
  sessionActive Boolean        @default(false)
  items         UserCartItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, scope])
  @@index([userId, scope])
}

model UserCartItem {
  id            Int      @id @default(autoincrement())
  cartId        Int
  cart          UserCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     Int? // selected variant (nullable)
  label         String? // kode pelanggan per baris (Aneka), terpisah dari variasi
  quantity      Int
  priceOverride Int?
  satuanPesan   String   @default("pcs")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
}

model OrderRequest {
  id              Int                  @id @default(autoincrement())
  code            String               @unique
  customerName    String
  phone           String
  status          String               @default("Menunggu")
  rejectionReason String?
  totalPrice      Int
  transactionId   Int?                 @unique
  transaction     Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  items           OrderRequestItem[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model OrderStatusHistory {
  id             Int          @id @default(autoincrement())
  orderRequestId Int
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  status         String
  description    String?
  createdAt      DateTime     @default(now())

  @@index([orderRequestId, createdAt])
}

model OrderRequestItem {
  id             Int          @id @default(autoincrement())
  orderRequestId Int
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  productName    String
  // Varian yang dipilih pembeli. Mengikuti pola CustomerPrice: variantId 0 =
  // produk tanpa varian, jadi tidak perlu nullable. Sengaja TANPA relasi ke
  // ProductVariant — `variantName` adalah snapshot nama saat pesanan dibuat,
  // supaya pesanan lama tetap terbaca utuh walau variannya kelak dihapus atau
  // diganti nama (sama alasannya dengan `productName` di atas).
  variantId      Int          @default(0)
  variantName    String?
  quantity       Int
  unitPrice      Int
  subtotal       Int

  @@index([orderRequestId])
  @@index([productId])
}
